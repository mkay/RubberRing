    <!-- ===== Support dialog ===== -->

    <string name="support_title">Keep this app alive</string>
    <string name="support_intro">This app doesn\'t track. Anything.\nThe downside is I have no idea if or how often it\'s used or downloaded.\nCould be zero, could be a secret cult following. I genuinely don\'t know.</string>
    <string name="support_question">Am I wasting my time publishing it? You tell me.</string>
    <string name="support_ways">There are three (maybe more) ways to keep me motivated:</string>

    <string name="support_easy_title">The easy way</string>
    <string name="support_easy_action">Give it a like</string>
    <string name="support_easy_note">Opens a page on my website with a like button. Nothing is counted until you press it — just the press and an anonymised IP.</string>
    <string name="support_nerdy_title">The nerdy way</string>
    <string name="support_nerdy_action">Star it on GitHub</string>
    <string name="support_nerdy_note">A star is a number I can actually see, and it helps others find it.</string>
    <string name="support_generous_title">The generous way</string>
    <string name="support_generous_action">Support it on Ko-fi</string>
    <string name="support_generous_note">Entirely optional. The app is and stays free either way.</string>

