    <!-- ===== Quick help ===== -->

    <string name="help_title">Quick help</string>
    <string name="help_marker_title">Move a marker</string>
    <string name="help_marker_body">Long-press a marker\'s grip tab (or its line) until it grabs, then drag it. The short hold prevents accidental nudges.</string>
    <string name="help_playhead_title">Move the playhead</string>
    <string name="help_playhead_body">Tap anywhere in open space to jump the playhead there, or drag near the playhead line to scrub it.</string>
    <string name="help_countin_title">Start with a count-in</string>
    <string name="help_countin_body">Long-press Play to hear a count-in before the audio comes in; a normal tap starts straight away. Under Options → Click, set its meter and length, keep the click going through the loop, and pick its volume and pitch.</string>
    <string name="help_zoom_title">Zoom &amp; scroll</string>
    <string name="help_zoom_body">Pinch with two fingers to zoom the waveform in and out. When zoomed in, drag in open space to scroll, or use the minimap strip at the bottom.</string>
    <string name="help_save_loop_title">Save a loop</string>
    <string name="help_save_loop_body">Set the start and end markers, then tap + to store the region under a name. Saved loops belong to the current track.</string>
    <string name="help_recall_loop_title">Recall a loop</string>
    <string name="help_recall_loop_body">Tap a saved loop to jump its markers back into place. Long-press it and drag to move it along the row; long-press and let go for rename and delete options.</string>

