    <string name="audio_intro">Boost a track that was mixed too quietly.</string>
    <!-- Shown as a bolded name joined to its description by a space, so the description
         continues the sentence: "Peak raises it until…" -->
    <string name="audio_peak_name">Peak</string>
    <string name="audio_peak_desc">raises it until its loudest moment is as loud as it can get, without altering the sound.</string>
    <string name="audio_loudness_name">Loudness</string>
    <string name="audio_loudness_desc">goes by average level instead — it can lift a track Peak has nothing left to give, at the cost of easing the sharpest peaks back a little.</string>

